{
  "name": "gitremind",
  "version": "1.0.0",
  "description": "Intelligent background Git watcher and uncommitted changes daemon with Claude CLI-style dashboard, smart commit reminders, conventional commit wizard, and cross-platform desktop notifications.",
  "type": "module",
  "bin": {
    "gitremind": "./bin/gitremind.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "npm run build",
    "start": "node dist/cli/index.js",
    "dev": "tsx src/cli/index.ts",
    "test": "tsx --test tests/**/*.test.ts"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/gitremind/gitremind.git"
  },
  "homepage": "https://github.com/gitremind/gitremind#readme",
  "bugs": {
    "url": "https://github.com/gitremind/gitremind/issues"
  },
  "keywords": [
    "git",
    "git-reminder",
    "git-watcher",
    "uncommitted-changes",
    "uncommitted-changes-reminder",
    "git-commit-reminder",
    "git-daemon",
    "git-tracker",
    "developer-productivity",
    "developer-tools",
    "cli-dashboard",
    "conventional-commits",
    "desktop-notifications",
    "windows-toast",
    "macos-notifications",
    "linux-notifications",
    "tui",
    "git-status",
    "git-workflow",
    "code-safety"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "author": "GitRemind Contributors",
  "license": "MIT",
  "dependencies": {
    "chokidar": "^4.0.3",
    "commander": "^13.1.0",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "@types/node": "^22.13.14",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}

